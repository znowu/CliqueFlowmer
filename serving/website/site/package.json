{
  "name": "cliqueflowmer-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm run preview:cloudflare",
    "build": "vite build --config cloudflare/vite.config.ts",
    "build:cloudflare": "npm run build",
    "typecheck": "tsc --noEmit --incremental false",
    "check:cloudflare": "wrangler deploy --cwd cloudflare --config wrangler.jsonc --dry-run --outdir ../dist/cloudflare/worker",
    "preview:cloudflare": "wrangler dev --config cloudflare/wrangler.jsonc --local --ip 127.0.0.1 --port 5173 --inspector-port 0",
    "deploy:cloudflare": "npm run build && wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "description": "Interactive crystal representations, reconstruction, and optimization with CliqueFlowmer."
}
